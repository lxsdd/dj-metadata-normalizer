#include "resource.h"

IDR_DEFAULT_RULESET RCDATA "../../rules/default-rules.json"

IDD_PREPARE_TRACKS DIALOGEX 0, 0, 480, 188
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Tracks vorbereiten (nur Vorschau)"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Vorlage:", -1, 12, 15, 78, 12
    COMBOBOX        IDC_PREPARE_PROFILE, 94, 12, 373, 92, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Profilname:", -1, 12, 45, 78, 12
    EDITTEXT        IDC_PREPARE_NAME, 94, 42, 373, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Zielordner:", -1, 12, 73, 78, 12
    EDITTEXT        IDC_PREPARE_DESTINATION, 94, 70, 373, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Dateinamensmuster:", -1, 12, 100, 79, 23
    EDITTEXT        IDC_PREPARE_PATTERN, 94, 98, 373, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "foobar Title Formatting; die Eingaben gelten nur fuer diese Vorschau.", -1, 94, 118, 373, 12
    LTEXT           "Es werden keine Tags oder Dateien geaendert. Keine Zielpruefung oder CUE-Operation.", -1, 12, 142, 454, 12
    DEFPUSHBUTTON   "Vorschau", IDOK, 327, 163, 66, 17
    PUSHBUTTON      "Abbrechen", IDCANCEL, 401, 163, 66, 17
END

IDD_MENU_PREFERENCES DIALOGEX 0, 0, 485, 194
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_VISIBLE | WS_CLIPSIBLINGS
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Metadaten-Vorschau:", -1, 12, 17, 105, 12
    EDITTEXT        IDC_CAPTION_METADATA, 122, 13, 349, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Singles-Vorschau:", -1, 12, 47, 105, 12
    EDITTEXT        IDC_CAPTION_SINGLES, 122, 43, 349, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Alben-Vorschau:", -1, 12, 77, 105, 12
    EDITTEXT        IDC_CAPTION_ALBEN, 122, 73, 349, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Livesets-Vorschau:", -1, 12, 107, 105, 12
    EDITTEXT        IDC_CAPTION_LIVESETS, 122, 103, 349, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Tracks vorbereiten:", -1, 12, 137, 105, 12
    EDITTEXT        IDC_CAPTION_PREPARE, 122, 133, 349, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Sichtbarkeit und Menuehierarchie verwaltet foobar unter Display > Context Menu.", -1, 12, 163, 464, 14
    LTEXT           "Apply speichert; Cancel verwirft; Reset setzt Standardnamen nur zurueck.", -1, 12, 179, 464, 12
END
