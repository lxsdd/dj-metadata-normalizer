#include "resource.h"
#include <windows.h>
#include <commctrl.h>

IDR_DEFAULT_RULESET RCDATA "../../rules/default-rules.json"

IDD_MENU_PREFERENCES DIALOGEX 0, 0, 485, 194
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_VISIBLE | WS_CLIPSIBLINGS
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Metadata preview:", -1, 12, 17, 105, 12
    EDITTEXT        IDC_CAPTION_METADATA, 122, 13, 349, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Singles preview:", -1, 12, 47, 105, 12
    EDITTEXT        IDC_CAPTION_SINGLES, 122, 43, 349, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Albums preview:", -1, 12, 77, 105, 12
    EDITTEXT        IDC_CAPTION_ALBEN, 122, 73, 349, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Live Sets preview:", -1, 12, 107, 105, 12
    EDITTEXT        IDC_CAPTION_LIVESETS, 122, 103, 349, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Prepare Tracks:", -1, 12, 137, 105, 12
    EDITTEXT        IDC_CAPTION_PREPARE, 122, 133, 349, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Show/hide: Display > Context Menu.", -1, 12, 163, 464, 12
    LTEXT           "Apply saves. Cancel discards. Reset restores defaults.", -1, 12, 179, 464, 12
END

IDD_BATCH_PREVIEW DIALOGEX 0, 0, 710, 396
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Prepare Tracks - Batch Preview (No Writes)"
FONT 9, "Segoe UI"
BEGIN
    CONTROL         "", IDC_BATCH_TABS, "SysTabControl32", WS_CHILD | WS_VISIBLE | WS_TABSTOP, 10, 9, 690, 28
    LTEXT           "Show:", IDC_METADATA_FILTER_LABEL, 10, 40, 45, 12
    COMBOBOX        IDC_METADATA_FILTER, 58, 37, 180, 82, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "", IDC_METADATA_TRACK_LIST, "SysListView32", WS_BORDER | WS_TABSTOP | LVS_REPORT | LVS_OWNERDATA | LVS_SHOWSELALWAYS, 10, 59, 290, 262
    CONTROL         "", IDC_METADATA_LIST, "SysListView32", WS_BORDER | WS_TABSTOP | LVS_REPORT | LVS_OWNERDATA | LVS_SHOWSELALWAYS, 306, 59, 394, 262
    CONTROL         "", IDC_BATCH_LIST, "SysListView32", WS_BORDER | WS_TABSTOP | LVS_REPORT | LVS_OWNERDATA | LVS_SHOWSELALWAYS, 10, 39, 690, 210
    LTEXT           "Routing profile:", IDC_BATCH_ROUTE_LABEL, 10, 260, 85, 12
    COMBOBOX        IDC_BATCH_PROFILE_PICKER, 101, 258, 150, 78, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Profile name:", IDC_BATCH_NAME_LABEL, 265, 260, 78, 12
    EDITTEXT        IDC_BATCH_PROFILE_NAME, 347, 258, 353, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Destination:", IDC_BATCH_DEST_LABEL, 10, 287, 85, 12
    EDITTEXT        IDC_BATCH_DESTINATION, 101, 285, 599, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Naming expression:", IDC_BATCH_PATTERN_LABEL, 10, 313, 90, 12
    EDITTEXT        IDC_BATCH_PATTERN, 101, 311, 599, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Metadata proposals are read-only. Select File locations to edit routing; nothing is written.", IDC_BATCH_HINT, 10, 335, 680, 14
    PUSHBUTTON      "Preview selected", IDC_BATCH_APPLY_SELECTED, 405, 363, 104, 19
    PUSHBUTTON      "Preview all", IDC_BATCH_APPLY_ALL, 515, 363, 87, 19
    DEFPUSHBUTTON   "Close", IDCANCEL, 608, 363, 92, 19
END
