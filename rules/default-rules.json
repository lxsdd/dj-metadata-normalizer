{
  "schema_version": 2,
  "ruleset_id": "lxsdd.dj-metadata-normalizer.default",
  "revision": "2026-10-07.2",
  "rules": [
    {
      "id": "safe.normalize-unicode-whitespace",
      "enabled": true,
      "priority": 5,
      "fields": ["*"],
      "match": { "kind": "always" },
      "transform": { "kind": "normalize_unicode_whitespace" },
      "safety": "SAFE",
      "source": {
        "kind": "builtin",
        "rationale": "Map Unicode White_Space code points to ASCII space while preserving all non-whitespace UTF-8 bytes."
      }
    },
    {
      "id": "safe.trim-whitespace",
      "enabled": true,
      "priority": 10,
      "fields": ["*"],
      "match": { "kind": "always" },
      "transform": { "kind": "trim_whitespace" },
      "safety": "SAFE",
      "source": {
        "kind": "builtin",
        "rationale": "Remove leading and trailing ASCII whitespace after Unicode whitespace normalization."
      }
    },
    {
      "id": "safe.collapse-whitespace",
      "enabled": true,
      "priority": 20,
      "fields": ["*"],
      "match": { "kind": "always" },
      "transform": { "kind": "collapse_whitespace" },
      "safety": "SAFE",
      "source": {
        "kind": "builtin",
        "rationale": "Collapse repeated ASCII whitespace to one space after Unicode whitespace normalization."
      }
    }
  ]
}
